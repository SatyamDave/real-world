          },
          "iso3": {
            "type": "string",
            "title": "Iso3"
          },
          "tier": {
            "type": "string",
            "title": "Tier"
          },
          "segment": {
            "type": "string",
            "title": "Segment"
          },
          "traits": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Traits"
          },
          "shares": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Shares"
          },
          "moved": {
            "items": {
              "$ref": "#/components/schemas/AgentStep"
            },
            "type": "array",
            "title": "Moved"
          }
        },
        "type": "object",
        "required": ["agent_id", "iso3", "tier", "segment", "traits", "shares", "moved"],
        "title": "Agent"
      },
      "AgentStep": {
        "properties": {
          "date": {
            "type": "string",
            "title": "Date"
          },
          "topic": {
            "type": "string",
            "title": "Topic"
          },
          "delta": {
            "type": "number",
            "title": "Delta",
            "description": "Change in the agent's belief, in logit."
          },
          "cause": {
            "type": "string",
            "title": "Cause"
          }
        },
        "type": "object",
        "required": ["date", "topic", "delta", "cause"],
        "title": "AgentStep"
      },
      "AgentWhy": {
        "properties": {
          "agent_id": {
            "type": "string",
            "title": "Agent Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "label": {
            "type": "string",
            "const": "Simulated account, not the cause",
            "title": "Label",
            "default": "Simulated account, not the cause"
          },
          "simulated": {
            "type": "boolean",
            "const": true,
            "title": "Simulated",
            "default": true
          }
        },
        "type": "object",
        "required": ["agent_id", "text"],
        "title": "AgentWhy"
      },
      "Anchor": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["rfc3161", "opentimestamps"],
            "title": "Kind"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "requested_at": {
            "type": "string",
            "title": "Requested At"
          },
          "proof_base64": {
            "type": "string",
            "title": "Proof Base64"
          }
        },
        "type": "object",
        "required": ["kind", "service", "requested_at", "proof_base64"],
        "title": "Anchor"
      },
      "Answer": {
        "properties": {
          "question_id": {
            "type": "string",
            "title": "Question Id"
          },
          "player_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Player Id"
          },
          "probability": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Probability"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["question_id", "player_id", "probability"],
        "title": "Answer"
      },
      "Band": {
        "properties": {
          "p10": {
            "type": "number",
            "title": "P10"
          },
          "p50": {
            "type": "number",
            "title": "P50"
          },
          "p90": {
            "type": "number",
            "title": "P90"
          }
        },
        "type": "object",
        "required": ["p10", "p50", "p90"],
        "title": "Band"
      },
      "BaselineSkill": {
        "properties": {
          "n": {
            "type": "integer",
            "title": "N"
          },
          "n_pairs": {
            "type": "integer",
            "title": "N Pairs"
          },
          "mean_diff": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mean Diff"
          },
          "low": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Low"
          },
          "high": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "High"
          },
          "claim": {
            "type": "string",
            "enum": ["reportable", "insufficient_n"],
            "title": "Claim"
          },
          "by_tier": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Skill"
