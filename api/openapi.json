            "title": "Prev Root"
          },
          "root": {
            "type": "string",
            "title": "Root"
          },
          "leaf_count": {
            "type": "string",
            "title": "Leaf Count"
          },
          "protocol_hash": {
            "type": "string",
            "title": "Protocol Hash"
          },
          "engine_version": {
            "type": "string",
            "title": "Engine Version"
          },
          "record_hash": {
            "type": "string",
            "title": "Record Hash"
          },
          "anchor": {
            "type": "string",
