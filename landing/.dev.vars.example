# Copy to landing/.dev.vars and fill in. NEVER commit .dev.vars (it is git-ignored).
# For Cloudflare Pages preview, load each with: wrangler pages secret put <NAME>

# --- Environments: dev (local), staging (Pages preview), prod (Pages production) ---
# ENVIRONMENT tags every Amplitude event. "development" logs events to the console and sends
# nothing. Pages sets its own value: "staging" on preview, "production" on production.
ENVIRONMENT=development

# Neon Postgres connection strings (pooled), project real-world-landing, database "landing".
# DATABASE_URL is what `wrangler pages dev` reads locally: keep it on the `dev` branch.
# DATABASE_URL_STAGING is the `staging` branch (written to the Pages preview env by
# scripts/set-staging-env.mjs). DATABASE_URL_PROD is the `main` branch (read only by
# scripts/set-prod-secrets.sh at go-live).
DATABASE_URL=
DATABASE_URL_DEV=
DATABASE_URL_STAGING=
DATABASE_URL_PROD=

# Optional salt for the rate-limit IP hash; falls back to TURNSTILE_SECRET_KEY.
RATE_LIMIT_SALT=

# Amplitude is capped at two projects. STAGING is "Real World - Staging": staging, and dev when
# you opt in with VITE_AMPLITUDE_DEV_SEND=true. PROD is "Real World - Prod": production only.
AMPLITUDE_API_KEY_STAGING=
AMPLITUDE_API_KEY_PROD=

# Cloudflare Turnstile (bot check on the signup form).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Real widget for tryrealworld.com (production only; scripts/build.mjs and set-prod-secrets.sh
# refuse Cloudflare's test keys).
TURNSTILE_SITE_KEY_PROD=
TURNSTILE_SECRET_KEY_PROD=

# Typeform — personal access token (form create/update) and webhook signing secret.
TYPEFORM_TOKEN=
TYPEFORM_WEBHOOK_SECRET=

# The v1 app base URL (Satyam hosts web/ separately). While empty, all "Try it" links are hidden.
# APP_URL is the canonical server value; VITE_APP_URL (below) mirrors it into the client bundle,
# because the "Try today's question" link is rendered in the browser. Keep the two the same.
APP_URL=

# --- Build-time public vars (VITE_*, safe to expose in the client bundle) ---
# Base URL of the landing deployment, used for canonical/OG tags. A *.pages.dev preview tonight.
VITE_PUBLIC_BASE_URL=
# The v1 app URL exposed to the client (mirror of APP_URL). Empty hides all "Try it" links.
VITE_APP_URL=
# Set by scripts/build.mjs (pnpm build:staging / build:prod) from the values above; set by hand
# only for `pnpm dev`. VITE_ENVIRONMENT defaults to "development" under `vite dev`.
VITE_ENVIRONMENT=
VITE_AMPLITUDE_API_KEY=
# Dev only: send to Amplitude (staging key) instead of logging to the console.
VITE_AMPLITUDE_DEV_SEND=false
# Typeform form id (printed by `node scripts/typeform-sync.mjs`, stored in typeform/form-id.txt).
VITE_TYPEFORM_FORM_ID=
# Turnstile site key again, exposed to the browser widget.
VITE_TURNSTILE_SITE_KEY=
# Session-replay sample rate, 0..1.
VITE_AMPLITUDE_REPLAY_SAMPLE_RATE=0.1
# Ad pixels. Each loads only when its id is set; leave empty to disable that channel.
VITE_REDDIT_PIXEL_ID=
VITE_X_PIXEL_ID=
# The X Ads Manager event id for a Lead on the X pixel (tw-<pixel>-<event>). Empty = no X Lead event.
VITE_X_LEAD_EVENT_ID=
# Meta stays behind a flag until the policy review clears; off by default.
VITE_ENABLE_META_PIXEL=false
VITE_META_PIXEL_ID=
