{
  "name": "landing",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions",
    "gen:poster": "python3 scripts/gen_globe_poster.py",
    "e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle.mjs",
    "ads": "node scripts/make-ads.mjs",
    "build:staging": "node scripts/build.mjs staging",
    "build:prod": "node scripts/build.mjs production"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "2.47.2",
    "@amplitude/plugin-session-replay-browser": "1.35.5",
    "@neondatabase/serverless": "1.2.0",
    "cobe": "2.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "5.20261002.1",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
